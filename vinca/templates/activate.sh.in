# DO NOT EDIT!
# if [ -z "${CONDA_PREFIX}" ]; then
#     exit 0;
# fi

case "$OSTYPE" in
  msys*|cygwin*)
    # Windows: conda runs this script (not activate.bat) when the environment
    # is activated from Git Bash / MSYS2 / Cygwin. The ROS packages only ship
    # .bat/.dsv environment hooks there (under %CONDA_PREFIX%\Library), so do
    # what activate.bat -> local_setup.bat does: let ament's
    # _local_setup_util.py evaluate every package's .dsv hooks, in "sh" mode,
    # and apply the result. Values stay in Windows form (C:\...;C:\...) since
    # native Windows programs (python, cmake, ros2) read them; only PATH is
    # converted to the form the shell itself uses.
    if [ -n "${SYS_PREFIX:-}" ]; then
      # Don't do anything when we are in conda build (as activate.bat).
      :
    elif ! command -v cygpath > /dev/null 2>&1; then
      echo "Not activating ROS: cygpath not found" >&2
    else
      _ros_prefix_w="$(cygpath -w "$CONDA_PREFIX")"
      _ros_python="$(cygpath -u "$_ros_prefix_w\\python.exe")"
      _ros_util="$(cygpath -u "$_ros_prefix_w\\Library\\_local_setup_util.py")"

      export QT_PLUGIN_PATH="$_ros_prefix_w\\Library\\plugins"
      unset PYTHONHOME

      if [ -f "$_ros_util" ]; then
        while IFS= read -r _ros_line; do
          case "$_ros_line" in
            "export PATH=\""*";\$PATH\"")
              # prepend: convert C:\...\bin to /c/.../bin and use ':'
              _ros_value="${_ros_line#export PATH=\"}"
              _ros_value="${_ros_value%;\$PATH\"}"
              export PATH="$(cygpath -u "$_ros_value"):$PATH"
              ;;
            "export PATH="*)
              # anything else touching PATH: skip rather than corrupt it
              ;;
            "export "*"#:}")
              # strip a leading separator: ';' on Windows, not ':'
              eval "${_ros_line%#:\}}#;}"
              ;;
            "export "*"%:}")
              # strip a trailing separator: ';' on Windows, not ':'
              eval "${_ros_line%\%:\}}%;}"
              ;;
            "export "*)
              eval "$_ros_line"
              ;;
          esac
        done <<EOF
$("$_ros_python" "$_ros_util" sh | tr -d '\r')
EOF
      fi

      export ROS_OS_OVERRIDE="conda:win64"
      export ROS_ETC_DIR="$_ros_prefix_w\\Library\\etc\\ros"
      export AMENT_PREFIX_PATH="$_ros_prefix_w\\Library"
      export AMENT_PYTHON_EXECUTABLE="$_ros_prefix_w\\python.exe"
      unset _ros_prefix_w _ros_python _ros_util _ros_line _ros_value
    fi
    ;;
  *)
    # Not sure if this is necessary on UNIX?
    # export QT_PLUGIN_PATH=$CONDA_PREFIX\plugins

    if [ "$CONDA_BUILD" = "1" -a "$target_platform" != "$build_platform" ]; then
        # ignore sourcing
        echo "Not activating ROS when cross-compiling";
    else
        source $CONDA_PREFIX/setup.sh
    fi

    case "$OSTYPE" in
      darwin*)  export ROS_OS_OVERRIDE="conda:osx";;
      linux*)   export ROS_OS_OVERRIDE="conda:linux";;
    esac

    export ROS_ETC_DIR=$CONDA_PREFIX/etc/ros
    export AMENT_PREFIX_PATH=$CONDA_PREFIX

    # Looks unnecessary for UNIX
    # unset PYTHONHOME=
    ;;
esac
